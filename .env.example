# Copia estas variables en Vercel → tu proyecto → Settings → Environment Variables.
# NUNCA pongas claves reales en GitHub.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # la "service_role" (secreta). Solo en Vercel.

# Stripe → Developers → API keys (empieza por sk_test_ para pruebas, sk_live_ en real)
STRIPE_SECRET_KEY=sk_test_...
# Stripe → Developers → Webhooks → tu endpoint → Signing secret (recomendado)
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (correo) → API Keys. EMAIL_FROM debe ser de un dominio verificado en Resend.
RESEND_API_KEY=re_...
EMAIL_FROM=Cristhian Pérez Tattoo <reservas@tudominio.com>
OWNER_EMAIL=correo-del-estudio@gmail.com      # aquí llegan las nuevas reservas y pedidos

# Panel /admin
ADMIN_PASSWORD=pon-una-contraseña-larga
ADMIN_SESSION_SECRET=cadena-aleatoria-de-al-menos-32-caracteres

# Dirección pública de la web (para los enlaces de Stripe y de los correos)
SITE_URL=https://cristhianpereztattoo.com

# Aviso de cada reserva por WhatsApp al estudio (CallMeBot, gratuito). Ver README.
OWNER_WHATSAPP=34646623706
CALLMEBOT_APIKEY=
